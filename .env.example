# Copy to .env and fill in. Never commit .env.

# --- MySQL root credentials (used by db/maintenance/backup.sh and restore.sh) ---
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=manzaneque_helpdesk

# --- App DB connection (restricted user, not root) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME_APP=manzaneque_helpdesk
DB_APP_USER=hd_app
DB_APP_PASSWORD=change_me_app

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_COST=12

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
